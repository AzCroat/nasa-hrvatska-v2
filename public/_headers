/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 1; mode=block
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(self), geolocation=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Cross-Origin-Embedder-Policy: unsafe-none
  # HARDENED 2026-08-10: script-src carries NO 'unsafe-inline'. The app ships
  # zero inline scripts by design — the boot-shell theme init lives in
  # native-init.js, offline.html's behavior in offline-init.js, and the
  # keepPublicScriptsExternal vite plugin reverts anything Vite tries to
  # inline. The only historical consumer was Cloudflare's auto-injected Web
  # Analytics beacon (redundant — Plausible is our analytics). The API token
  # lacks the RUM scope to turn injection off (cf-web-analytics.yml recon),
  # so if CF still injects it, this policy BLOCKS it — which is the desired
  # end state; the only cost is a console violation line. style-src keeps
  # 'unsafe-inline' on purpose: React inline styles + the boot-shell <style>.
  #
  # challenges.cloudflare.com (in script-src, connect-src, frame-src) is REQUIRED
  # for the Cloudflare Turnstile signup widget (src/components/auth/TurnstileWidget.tsx).
  # Turnstile loads /turnstile/v0/api.js (script-src), renders its challenge in an
  # iframe (frame-src) and calls back to the same host (connect-src). Without all
  # three, the widget's onerror fires and the Sign-Up screen shows "Could not load
  # verification challenge…", leaving "Create Account" permanently disabled — i.e.
  # new registrations are blocked. Do not remove unless Turnstile is removed from
  # the auth flow. — added 2026-06-27, CSP/Turnstile mismatch shipped with #55.
  Content-Security-Policy: default-src 'self'; script-src 'self' https://www.gstatic.com/firebasejs/ https://*.firebaseapp.com https://*.googleapis.com https://apis.google.com https://plausible.io https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; media-src 'self' data: blob: https:; connect-src 'self' blob: https://*.firebaseio.com https://*.googleapis.com https://*.firebaseapp.com https://*.cloudfunctions.net https://*.cognitiveservices.azure.com wss://*.firebaseio.com https://*.posthog.com https://app.posthog.com https://*.ingest.sentry.io https://*.ingest.us.sentry.io https://sentry.io https://plausible.io https://challenges.cloudflare.com; worker-src 'self' blob:; frame-src https://www.google.com https://www.youtube-nocookie.com https://www.youtube.com https://open.spotify.com https://challenges.cloudflare.com; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests;

# The document is served at "/" — Pages redirects /index.html to / (pretty
# URLs), and _headers rules match the REQUEST path, so a rule on /index.html
# never applies to the URL users actually load. The shell must never be
# cacheable: stale HTML references content-hashed assets the current deploy no
# longer has, and (before the middleware guard) the SPA fallback for those was
# an HTML page cached as immutable JS — the 2026-08 blank-screen incident.
/
  Cache-Control: no-cache, no-store, must-revalidate

/index.html
  Cache-Control: no-cache, no-store, must-revalidate

/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

/workbox-*.js
  Cache-Control: no-cache, no-store, must-revalidate

/manifest.webmanifest
  Cache-Control: no-cache, no-store, must-revalidate

/version.json
  Cache-Control: no-cache, no-store, must-revalidate

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/audio/*
  Cache-Control: public, max-age=31536000, immutable

# /api/* routes are handled by Cloudflare Pages Functions (functions/api/).
# CORS headers are set dynamically by the Function to echo the request Origin.
# Do NOT set static CORS headers here — they would override the Function's dynamic response.
